@@ -0,0 +1,33 @@
+package filius.web;
+
+/**
+ * Pont entre Filius et la page web lorsque Filius est exécuté dans un navigateur avec CheerpJ.
+ *
+ * Les méthodes natives sont implémentées en JavaScript dans index.html (option "natives" de cheerpjInit). Hors
+ * navigateur (propriété système filius.web absente), elles ne sont jamais appelées.
+ */
+public final class WebBridge {
+
+    private WebBridge() {}
+
+    /** @return true si Filius tourne dans le navigateur (lancé avec -Dfilius.web=true). */
+    public static boolean isActive() {
+        return Boolean.getBoolean("filius.web");
+    }
+
+    /**
+     * Demande à la page d'afficher un sélecteur de fichier du navigateur. Le fichier choisi est copié dans le système
+     * de fichiers virtuel de CheerpJ.
+     *
+     * @return le chemin du fichier copié (par ex. /str/import/1/reseau.fls), ou une chaîne vide si l'utilisateur annule.
+     */
+    public static native String ouvrirFichier();
+
+    /**
+     * Demande à la page de proposer le fichier au téléchargement (il arrive dans le dossier Téléchargements).
+     *
+     * @param chemin chemin du fichier dans le système de fichiers virtuel (par ex. /files/filius/reseau.fls)
+     * @param nom nom proposé pour le fichier téléchargé
+     */
+    public static native void telechargerFichier(String chemin, String nom);
+}
